# 服务器配置
NODE_ENV=production
PORT=3000

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=construction_simple
DB_USER=postgres
DB_PASSWORD=your_password

# JWT 配置
JWT_SECRET=your-super-secret-key-change-in-production-please
JWT_EXPIRES_IN=7d

# 文件上传配置
UPLOAD_DIR=/var/www/uploads
MAX_FILE_SIZE=5242880
MAX_FILES=10

# CORS 配置
# 开发环境：留空或设置为 * 
# 生产环境：无需配置（代码中已硬编码 winaii.com）
